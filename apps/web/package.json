{
  "name": "web",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "predev": "command -v portless >/dev/null 2>&1 || { echo '\\nportless is required but not installed.\\nRun: npm install -g portless\\n' >&2; exit 1; }",
    "dev": "portless emulate next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "vinext start",
    "deploy:preview": "sh -c 'test -n \"$PREVIEW_ALIAS\" || { echo >&2 \"PREVIEW_ALIAS is required\"; exit 1; }; pnpm run build:vinext && wrangler versions upload --preview-alias \"$PREVIEW_ALIAS\"'",
    "deploy:production": "pnpm run build:vinext && wrangler deploy"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.118",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "ai": "^6.0.116",
    "bash-tool": "^1.3.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.0",
    "just-bash": "^2.14.0",
    "lucide-react": "^0.577.0",
    "next": "16.2.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.40.1",
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitejs/plugin-rsc": "^0.5.27",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "react-server-dom-webpack": "^19.2.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vinext": "^0.0.55",
    "vite": "^8.0.16",
    "wrangler": "^4.99.0"
  },
  "type": "module"
}
