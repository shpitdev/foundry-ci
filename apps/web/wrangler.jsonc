{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "foundryci-docs",
  // vinext's App Router entry. The site uses no next/image optimization and
  // no ISR, so the stock entry suffices; switch to a worker/index.ts wrapper
  // (see the vinext README) if either is ever added.
  "main": "vinext/server/app-router-entry",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-06-10",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "foundryci.com",
      "custom_domain": true
    },
    {
      "pattern": "www.foundryci.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  }
}
